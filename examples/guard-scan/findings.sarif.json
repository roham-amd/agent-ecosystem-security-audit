{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "AESA Guard",
          "version": "3.4.0",
          "informationUri": "https://github.com/roham-amd/agent-ecosystem-security-audit",
          "rules": [
            {
              "id": "AESA-RULE-002",
              "name": "MCP local command with broad filesystem arguments",
              "shortDescription": {
                "text": "MCP local command with broad filesystem arguments"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "AESA-RULE-002",
          "level": "error",
          "message": {
            "text": "MCP server `filesystem-broad` is registered with a local command transport. Environment inheritance or broad path arguments elevate this beyond a simple capability observation."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".cursor/mcp.json"
                },
                "region": {
                  "startLine": 4,
                  "endLine": 4
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
