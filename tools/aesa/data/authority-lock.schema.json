{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/roham-amd/agent-ecosystem-security-audit/schemas/authority-lock.schema.json",
  "title": "AUTHORITY.lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "product": { "type": "string", "default": "authdiff" },
    "mcp_tools": {
      "type": "object",
      "description": "tool name → description sha256 digest (sha256:…)",
      "additionalProperties": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
    },
    "mcp_servers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "command": { "type": "string" },
          "args_digest": { "type": "string" },
          "allowed": { "type": "boolean" }
        }
      }
    },
    "approved_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fingerprint", "justification"],
        "properties": {
          "fingerprint": { "type": "string" },
          "justification": { "type": "string", "minLength": 8 },
          "owner": { "type": "string" }
        }
      }
    }
  }
}
